{
  "notify": {
    "url": "http://127.0.0.1:8080/hook",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json",
      "X-Auth": "Bearer <Token>"
    },
    "send": "errors",
    "format": "json"
  },
  "tasks": [
    {
      "id": "HTTPBIN POST Request",
      "task": {
        "interval": "0 */10 * * * *"
      },
      "params": {
        "url": "http://httpbin.org/post",
        "method": "POST",
        "headers": {
          "authorization": "Bearer <Token>",
          "content-type": "application/json"
        }
      }
    }
  ]
}